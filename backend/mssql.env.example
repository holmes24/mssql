# Copy this file to .env.mssql for the local Docker SQL Server configuration.
DB_BACKEND=mssql
MSSQL_SERVER=host.docker.internal
MSSQL_DATABASE=attendance_agent_local
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=false
MSSQL_USERNAME=attendance_dev_app
MSSQL_PASSWORD=replace-with-a-strong-random-password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
